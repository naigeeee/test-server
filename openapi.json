{
  "openapi": "3.1.0",
  "info": {
    "title": "PDFF - FSM - Master",
    "version": "3.0.0",
    "description": "Google Sheets data import and analysis tool."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string" } } } } }
          }
        }
      }
    },
    "/api/info": {
      "get": {
        "summary": "App info and loaded sheets",
        "operationId": "info",
        "responses": {
          "200": { "description": "App metadata", "content": { "application/json": { "schema": { "type": "object" } } } }
        }
      }
    },
    "/api/upload": {
      "post": {
        "summary": "Upload Main sheet CSV/TSV",
        "operationId": "uploadMain",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "csv_text": { "type": "string" } }, "required": ["csv_text"] } } }
        },
        "responses": { "200": { "description": "Upload result" } }
      }
    },
    "/api/upload/booking": {
      "post": {
        "summary": "Upload Booking v2 CSV/TSV",
        "operationId": "uploadBooking",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "csv_text": { "type": "string" } }, "required": ["csv_text"] } } }
        },
        "responses": { "200": { "description": "Upload result" } }
      }
    },
    "/api/upload/file": {
      "post": {
        "summary": "Upload CSV/TSV file",
        "operationId": "uploadFile",
        "parameters": [
          { "name": "sheet", "in": "query", "schema": { "type": "string", "default": "main" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "multipart/form-data": { "schema": { "type": "object", "properties": { "file": { "type": "string", "format": "binary" } }, "required": ["file"] } } }
        },
        "responses": { "200": { "description": "Upload result" } }
      }
    },
    "/api/upload/{sheet}": {
      "delete": {
        "summary": "Clear sheet data from memory",
        "operationId": "clearSheet",
        "parameters": [
          { "name": "sheet", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Cleared" } }
      }
    },
    "/api/data/{sheet}": {
      "get": {
        "summary": "Get sheet data with search, filter, sort",
        "operationId": "getSheetData",
        "parameters": [
          { "name": "sheet", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "col", "in": "query", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 500 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": { "200": { "description": "Sheet data with headers and rows" } }
      }
    },
    "/api/analysis/{sheet}": {
      "get": {
        "summary": "Get column statistics for a sheet",
        "operationId": "analyzeSheet",
        "parameters": [
          { "name": "sheet", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Column statistics" } }
      }
    }
  }
}
